# Frontend environment configuration for WebVital Monitor

# Backend API base URL (e.g., http://localhost:8080)
REACT_APP_API_BASE_URL=http://localhost:8080

# Google OAuth Client ID for Google Identity Services
# Obtain from Google Cloud Console -> OAuth 2.0 Client IDs (Web)
REACT_APP_GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID

# Site base URL (used by auth flows that require redirect URLs)
REACT_APP_SITE_URL=http://localhost:3000
